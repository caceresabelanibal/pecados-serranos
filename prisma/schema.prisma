generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PecadoProduct {
  id                    String   @id @default(cuid())
  sku                   String   @unique
  tipo                  String   @default("Conjunto de lencería")
  category              String   @default("Conjunto de lencería")
  title                 String
  description           String   @default("")
  costoSinIva           Float    @default(0)
  costoConIva           Float    @default(0)
  multiplicadorGanancia  Float    @default(2.0)
  gananciaSugerida      Float    @default(0)
  precioEfectivo        Float    @default(0)
  precioTarjeta         Float    @default(0)
  precioFinalProveedor  Float    @default(0)
  stock                 Int      @default(0)
  minStock              Int      @default(2)
  observaciones         String   @default("")
  image                 String   @default("/pecados/auriculares.jpg")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sku])
  @@index([tipo])
}

model PecadoReseller {
  id                String   @id @default(cuid())
  name              String
  phone             String   @default("")
  zone              String   @default("")
  commissionPercent Float    @default(15)
  // Comisión: "percent" (porcentaje de lo vendido) o "fixed" (monto fijo por unidad vendida)
  commissionType    String   @default("percent")
  commissionFixed   Float    @default(0)
  notes             String   @default("")
  // Código propio que comparte con sus compradores (ej: MARU10)
  code              String?  @unique
  // Acceso al perfil "Asociado"
  username          String?  @unique
  passwordHash      String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PecadoSale {
  id            String           @id @default(cuid())
  // Código de pedido para el cliente y la tienda (2 letras + 4 números, ej: KM4821)
  orderCode     String?          @unique
  date          DateTime         @default(now())
  buyerName     String           @default("Cliente Mostrador")
  buyerPhone    String           @default("")
  channel       String           @default("direct_sale")
  resellerId    String?
  resellerName  String?
  totalAmount   Float            @default(0)
  paymentMethod String           @default("efectivo")
  status        String           @default("completed")
  notes         String           @default("")
  // Código de revendedora usado en la compra (si hubo)
  resellerCode  String?
  // Comisión total de la revendedora en esta venta; pending = algún artículo sin comisión definida
  commissionTotal   Float   @default(0)
  commissionPending Boolean @default(false)
  // Venta de revendedora rendida (pagada) a la tienda; null = sin rendir
  settledAt     DateTime?
  // Venta anulada (status = "cancelled"): se devolvió el stock y no cuenta en ningún total
  cancelledAt   DateTime?
  // Compra online pagada con Mercado Pago (status "pending" hasta que se acredita)
  mpPreferenceId String?
  mpPaymentId    String?
  // Último estado de pago informado por Mercado Pago (null = abrió el checkout pero nunca intentó pagar)
  mpStatus       String?
  // false = compra online todavía sin pagar: no descontó stock (se descuenta al confirmarse el pago)
  stockApplied   Boolean  @default(true)
  createdAt     DateTime         @default(now())
  items         PecadoSaleItem[]

  @@index([date])
}

model PecadoSaleItem {
  id           String     @id @default(cuid())
  saleId       String
  sale         PecadoSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String?
  productSku   String     @default("S/C")
  productTitle String
  quantity     Int        @default(1)
  unitPrice    Float      @default(0)
  subtotal     Float      @default(0)
  // Comisión de la revendedora por unidad (null = sin comisión definida) y total del ítem
  commissionUnit Float?
  commission     Float     @default(0)
  // Lote de mercadería en consignación del que salió (null = del depósito)
  consignmentId  String?

  @@index([saleId])
}

model PecadoConsignment {
  id               String   @id @default(cuid())
  resellerId       String
  resellerName     String
  date             DateTime @default(now())
  productId        String
  productSku       String   @default("S/C")
  productTitle     String
  quantityGiven    Int      @default(0)
  unitAgreedPrice  Float    @default(0)
  // Comisión de la revendedora por unidad vendida de este lote (la carga el admin al entregar)
  commissionPerUnit Float?
  quantitySold     Int      @default(0)
  quantityReturned Int      @default(0)
  status           String   @default("active")
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([resellerId])
  @@index([status])
}

model PecadoPurchase {
  id                 String   @id
  fileName           String   @default("Importación Excel")
  date               DateTime @default(now())
  source             String   @default("excel_import")
  notes              String   @default("")
  totalItems         Int      @default(0)
  newItems           Int      @default(0)
  restockItems       Int      @default(0)
  totalUnits         Int      @default(0)
  totalCostSinIva    Float    @default(0)
  totalCostConIva    Float    @default(0)
  totalSaleEstimated Float    @default(0)
  rawItemsJson       String   @default("[]")
  createdAt          DateTime @default(now())

  @@index([date])
}

model PecadoSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

// Interés de clientes en productos sin stock (no descuenta stock, no es una venta)
model PecadoInterest {
  id           String   @id @default(cuid())
  productId    String?
  productSku   String
  productTitle String
  quantity     Int      @default(1)
  buyerName    String   @default("")
  notes        String   @default("")
  // pending = nuevo | ordered = incluido en pedido a proveedor | closed = resuelto/descartado
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([productSku])
  @@index([status])
}

// Pedido a proveedor en preparación (lo que se va a comprar)
model PecadoPurchasePlanItem {
  id           String   @id @default(cuid())
  productSku   String   @unique
  productTitle String
  tipo         String   @default("")
  quantity     Int      @default(1)
  costoSinIva  Float    @default(0)
  image        String   @default("")
  fromInterest Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// Fotos de productos guardadas en la base (original + versión optimizada para la web)
model PecadoProductImage {
  sku       String   @id
  mime      String
  data      Bytes
  original  Bytes?
  sourceUrl String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
