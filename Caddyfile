# -------------------------------------------------------------
# Reverse proxy HTTPS para Pecados Serranos
# Caddy obtiene y renueva automáticamente el certificado (Let's Encrypt)
# -------------------------------------------------------------
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Restaurar un backup completo de la base desde el panel (archivos grandes)
	handle /api/admin/backup {
		request_body {
			max_size 200MB
		}
		reverse_proxy app:3000
	}

	# Resto del sitio: límite de tamaño de las peticiones (imágenes de productos incluidas)
	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy app:3000
	}
}

# www -> dominio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
