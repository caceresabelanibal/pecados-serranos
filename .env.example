# -------------------------------------------------------------
# Variables de Entorno - Pecados Serranos
# -------------------------------------------------------------

# Puerto expuesto en el servidor para la tienda web
APP_PORT=3000

# Base de Datos PostgreSQL (para Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
POSTGRES_DB=pecados_serranos
DB_PORT=127.0.0.1:5432

# URL de Conexión Prisma (se genera automáticamente en docker-compose)
DATABASE_URL=postgres://postgres:CAMBIAR_POR_UNA_CLAVE_LARGA@db:5432/pecados_serranos?schema=public

# Acceso administrador (OBLIGATORIO)
# Generar el hash con:  node scripts/hash-password.js 'TU_CONTRASEÑA'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Secreto para firmar sesiones (mínimo 32 caracteres):  openssl rand -hex 32
SESSION_SECRET=
# Poner en true cuando haya un reverse proxy (Caddy/nginx) con HTTPS delante
TRUST_PROXY=false
COOKIE_SECURE=false
