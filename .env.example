# -------------------------------------------------------------
# Variables de Entorno - Pecados Serranos
# -------------------------------------------------------------

# Puerto expuesto en el servidor para la tienda web
APP_PORT=3000

# Base de Datos PostgreSQL (para Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=pecados_serranos
DB_PORT=5432

# URL de Conexión Prisma (se genera automáticamente en docker-compose)
DATABASE_URL=postgres://postgres:postgres123@db:5432/pecados_serranos?schema=public
